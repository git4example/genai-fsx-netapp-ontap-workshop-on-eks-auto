{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EKSListClusters",
            "Effect": "Allow",
            "Action": [
                "eks:ListClusters"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EKSWorkshopClusterAccess",
            "Effect": "Allow",
            "Action": [
                "eks:DescribeCluster",
                "eks:AccessKubernetesApi",
                "eks:ListNodegroups"
            ],
            "Resource": [
                "arn:aws:eks:*:*:cluster/eksworkshop*"
            ]
        },
        {
            "Sid": "EKSWorkshopNodegroupRead",
            "Effect": "Allow",
            "Action": [
                "eks:DescribeNodegroup"
            ],
            "Resource": [
                "arn:aws:eks:*:*:nodegroup/eksworkshop*/*/*"
            ]
        },
        {
            "Sid": "FSxONTAPRead",
            "Effect": "Allow",
            "Action": [
                "fsx:DescribeFileSystems",
                "fsx:DescribeVolumes",
                "fsx:DescribeStorageVirtualMachines",
                "fsx:DescribeSnapshots"
            ],
            "Resource": "*"
        },
        {
            "Sid": "FSxUpdateThroughputForFailoverModule",
            "Effect": "Allow",
            "Action": [
                "fsx:UpdateFileSystem"
            ],
            "Resource": [
                "arn:aws:fsx:*:*:file-system/*"
            ]
        },
        {
            "Sid": "EC2Describe",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeSubnets",
                "ec2:DescribeAvailabilityZones",
                "ec2:DescribeSecurityGroups",
                "ec2:DescribeVpcs",
                "ec2:DescribeInstances",
                "ec2:DescribeNetworkInterfaces"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EC2ManagedResourceVisibilityRead",
            "Effect": "Allow",
            "Action": [
                "ec2:GetManagedResourceVisibility"
            ],
            "Resource": "*"
        },
        {
            "Sid": "IAMRoleForEksctl",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:GetRole",
                "iam:AttachRolePolicy",
                "iam:PutRolePolicy",
                "iam:TagRole"
            ],
            "Resource": [
                "arn:aws:iam::*:role/trident-*",
                "arn:aws:iam::*:role/eksctl-*",
                "arn:aws:iam::*:role/AmazonEKS*"
            ]
        },
        {
            "Sid": "IAMPolicyForEksctl",
            "Effect": "Allow",
            "Action": [
                "iam:CreatePolicy",
                "iam:GetPolicy"
            ],
            "Resource": [
                "arn:aws:iam::*:policy/Amazon_FSx_ONTAP_*",
                "arn:aws:iam::*:policy/eksctl-*"
            ]
        },
        {
            "Sid": "IAMPassRole",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": [
                        "eks.amazonaws.com",
                        "ec2.amazonaws.com"
                    ]
                }
            }
        },
        {
            "Sid": "IAMCreateSLR",
            "Effect": "Allow",
            "Action": "iam:CreateServiceLinkedRole",
            "Resource": "arn:aws:iam::*:role/aws-service-role/fsx.amazonaws.com/*",
            "Condition": {
                "StringEquals": {
                    "iam:AWSServiceName": "fsx.amazonaws.com"
                }
            }
        },
        {
            "Sid": "CloudFormationReadForEksctl",
            "Effect": "Allow",
            "Action": [
                "cloudformation:DescribeStacks",
                "cloudformation:ListStacks"
            ],
            "Resource": "*"
        },
        {
            "Sid": "CloudFormationWriteForEksctl",
            "Effect": "Allow",
            "Action": [
                "cloudformation:CreateStack",
                "cloudformation:DeleteStack"
            ],
            "Resource": [
                "arn:aws:cloudformation:*:*:stack/eksctl-*"
            ]
        },
        {
            "Sid": "SecretsManagerForTrident",
            "Effect": "Allow",
            "Action": [
                "secretsmanager:GetSecretValue"
            ],
            "Resource": "arn:aws:secretsmanager:*:*:secret:trident-fsx-*"
        },
        {
            "Sid": "STSCallerIdentity",
            "Effect": "Allow",
            "Action": [
                "sts:GetCallerIdentity"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ELBDescribe",
            "Effect": "Allow",
            "Action": [
                "elasticloadbalancing:Describe*"
            ],
            "Resource": "*"
        }
    ]
}
